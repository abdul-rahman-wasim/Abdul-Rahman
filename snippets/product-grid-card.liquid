{%- liquid
  assign card_image = image | default: product.featured_image
-%}

<div class="product-grid__item" {{ attributes }}>
  {%- if card_image != blank -%}
    {{
      card_image
      | image_url: width: 1200
      | image_tag:
        class: 'product-grid__image',
        loading: 'lazy',
        sizes: '(max-width: 749px) 100vw, 33vw',
        widths: '400, 600, 900, 1200'
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'product-grid__image' }}
  {%- endif -%}

  {%- if product != blank -%}
    <button
      class="product-grid__hotspot"
      type="button"
      aria-haspopup="dialog"
      aria-label="View details — {{ product.title | escape }}"
      style="--hotspot-x: {{ hotspot_x }}%; --hotspot-y: {{ hotspot_y }}%;"
      data-dialog="{{ dialog_id }}"
    >
      <svg viewBox="0 0 9 9" width="9" height="9" aria-hidden="true" focusable="false"><path d="M4.5 0v9M0 4.5h9" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>

    <dialog class="product-grid__dialog" id="{{ dialog_id }}" data-product-id="{{ product.id }}">
      <div class="product-grid__card">
        <button class="product-grid__close" type="button" data-close aria-label="Close">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>

        <div class="product-grid__summary">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 400
              | image_tag: class: 'product-grid__thumb', loading: 'lazy', widths: '200, 300, 400'
            }}
          {%- endif -%}

          <div class="product-grid__info">
            <h3 class="product-grid__title">{{ product.title }}</h3>
            <p class="product-grid__price" data-price>{{ product.price | money }}</p>
            <p class="product-grid__description">{{ product.description | strip_html | truncatewords: 26 }}</p>
          </div>
        </div>

        {%- for option in product.options_with_values -%}
          <div class="product-grid__option">
            <span class="product-grid__option-name">{{ option.name }}</span>

            {%- if forloop.first -%}
              <div class="product-grid__swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  <label class="product-grid__swatch">
                    <input
                      type="radio"
                      name="{{ dialog_id }}-option-{{ forloop.parentloop.index }}"
                      value="{{ value | escape }}"
                      data-option-index="{{ forloop.parentloop.index }}"
                      {% if forloop.first %}checked{% endif %}
                    >
                    <span class="product-grid__swatch-chip" style="--chip: {% if value.swatch.color %}{{ value.swatch.color }}{% else %}{{ value | downcase }}{% endif %};"></span>
                    <span class="product-grid__swatch-label">{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="product-grid__select">
                <select data-option-index="{{ forloop.index }}" aria-label="{{ option.name | escape }}">
                  <option value="">Choose your {{ option.name | downcase }}</option>
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}">{{ value }}</option>
                  {%- endfor -%}
                </select>
                <svg viewBox="0 0 14 8" width="14" height="8" fill="none" aria-hidden="true" focusable="false"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5"/></svg>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <p class="product-grid__error" data-error hidden></p>

        <button class="product-grid__submit" type="button" data-submit>
          <span data-submit-text>ADD TO CART</span>
          <svg viewBox="0 0 44 12" width="44" height="12" fill="none" aria-hidden="true" focusable="false"><path d="M0 6h41M36 1l6 5-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </button>

        <script type="application/json" data-variants>
          {
            {%- for variant in product.variants -%}
              {{ variant.options | join: ' / ' | json }}: {
                "id": {{ variant.id }},
                "available": {{ variant.available }},
                "price": {{ variant.price | money | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        </script>
      </div>
    </dialog>
  {%- endif -%}
</div>
